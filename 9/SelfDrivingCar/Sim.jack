//  The simulation: the car, the ring of four traffic rows, and collision.
//  tools/sim.py implements the same rules in Python (for training), and tools/run_tests.py compares the two
//  frame by frame. The comparison is exact, so keep the order of operations and where each division happens.
//  The car never moves in y: it sits at y = 0 and the traffic rows move relative to it.
//  Units: 1 U = 1/32 screen pixel. Heading 0..719 in half degrees (0..30 left, 690..719 right). */
class Sim {
    static int carx, theta, speed, fwd, passed;
    static boolean dead;
    static Array rowy, rowmask, counted;     // the four traffic rows
    static Array cornerX, cornerY;           // the car's four corners relative to its centre, in U
    static Array sin, cos, lane, bit, cnt, masks;

    // Allocates everything. Call after Tables.init().
    function void init() {
        let sin = Tables.getSin();
        let cos = Tables.getCos();
        let rowy = Array.new(4);
        let rowmask = Array.new(4);
        let counted = Array.new(4);
        let cornerX = Array.new(4);
        let cornerY = Array.new(4);
        let lane = Array.new(3);
        let lane[0] = 768; let lane[1] = 2304; let lane[2] = 3840;
        let bit = Array.new(3);
        let bit[0] = 1; let bit[1] = 2; let bit[2] = 4;
        // number of cars in a lane mask
        let cnt = Array.new(8);
        let cnt[0] = 0; let cnt[1] = 1; let cnt[2] = 1; let cnt[3] = 2;
        let cnt[4] = 1; let cnt[5] = 2; let cnt[6] = 2; let cnt[7] = 3;
        // the six masks a new row is drawn from; two cars in adjacent lanes never occur
        let masks = Array.new(6);
        let masks[0] = 1; let masks[1] = 2; let masks[2] = 4;
        let masks[3] = 5; let masks[4] = 2; let masks[5] = 5;
        return;
    }

    // Start state: middle lane, standing still, rows at -6400, -11200, -1600, 3200.
    function void reset(int s) {
        var int i;
        let carx = 2304;
        let theta = 0;
        let speed = 0;
        let fwd = 0;
        let passed = 0;
        let dead = false;
        let rowy[0] = -6400;
        let rowy[1] = -11200;
        let rowy[2] = -1600;
        let rowy[3] = 3200;
        let i = 0;
        while (i < 4) {
            let rowmask[i] = 0;
            let counted[i] = 0;
            let i = i + 1;
        }
        do Rng.setSeed(s);
        let i = 0;
        while (i < 8) {
            do Rng.next();
            let i = i + 1;
        }
        let rowmask[0] = Sim.drawMask();
        let rowmask[1] = Sim.drawMask();
        do Sim.corners();
        return;
    }

    // Advances the generator and picks a lane mask: MASKS[seed mod 6].
    function int drawMask() {
        var int s, q;
        let s = Rng.next();
        let q = s / 6;
        return masks[s - (q * 6)];
    }

    // One frame: move the car, move the traffic, check for a crash. mask = control mask:
    //  1 accelerate, 2 brake, 4 steer right, 8 steer left.
    function void step(int mask) {
        var int th, steer, rel, r, y;
        // 1. the car
        if (~((mask & 1) = 0)) { let speed = speed + 3; }
        if (~((mask & 2) = 0)) {
            let speed = speed - 3;
            if (speed < 0) { let speed = 0; }
        }
        if (speed > 0) {
            let th = theta;
            if (th > 359) { let th = th - 720; }
            let steer = mask & 12;
            if (steer = 4) {
                let th = th - 1;
            } else {
                if (steer = 8) {
                    let th = th + 1;
                } else {
                    // no steering: the heading moves one unit back toward straight ahead
                    if (th > 0) {
                        let th = th - 1;
                    } else {
                        if (th < 0) { let th = th + 1; }
                    }
                }
            }
            if (th > 30) { let th = 30; }
            if (th < (-30)) { let th = -30; }
            if (th < 0) { let theta = th + 720; } else { let theta = th; }
        }
        if (speed > 48) { let speed = 48; }
        if (speed > 0) { let speed = speed - 1; }
        let carx = carx - ((speed * sin[theta]) / 128);
        let fwd = (speed * cos[theta]) / 128;

        // 2. the traffic rows slide by (our forward speed - 31) and are recycled as a ring
        let rel = fwd - 31;
        let r = 0;
        while (r < 4) {
            let y = rowy[r] + rel;
            if (y > 4800) {
                let y = y - 19200;
                let rowmask[r] = Sim.drawMask();
                let counted[r] = 0;
            } else {
                if (y < (-14400)) {
                    // traffic pulled away and comes round from behind: not a pass
                    let y = y + 19200;
                    let rowmask[r] = Sim.drawMask();
                    let counted[r] = 1;
                }
            }
            let rowy[r] = y;
            if (y < (-1600)) { let counted[r] = 0; }
            if ((counted[r] = 0) & (y > 1600)) {
                let counted[r] = 1;
                let passed = passed + cnt[rowmask[r]];
            }
            let r = r + 1;
        }

        // 3. collision
        let dead = Sim.crashed();
        return;
    }

    // Computes the car's four corners (front-right, front-left, rear-left, rear-right).
    function void corners() {
        var int sn, cs, rx, ry, fx, fy;
        let sn = sin[theta];
        let cs = cos[theta];
        let rx = (25 * cs) / 8;
        let ry = -((25 * sn) / 8);
        let fx = -((25 * sn) / 4);
        let fy = -((25 * cs) / 4);
        let cornerX[0] = rx + fx;
        let cornerX[1] = (-rx) + fx;
        let cornerX[2] = (-rx) - fx;
        let cornerX[3] = rx - fx;
        let cornerY[0] = ry + fy;
        let cornerY[1] = (-ry) + fy;
        let cornerY[2] = (-ry) - fy;
        let cornerY[3] = ry - fy;
        return;
    }

    // True if the car overlaps a road border or a traffic car.
    function boolean crashed() {
        var int sn, cs, i, r, m, y, ln, ox, ex, ey, k, u, v, t;
        let sn = sin[theta];
        let cs = cos[theta];
        do Sim.corners();
        // road borders
        let i = 0;
        while (i < 4) {
            let t = carx + cornerX[i];
            if ((t < 0) | (t > 4608)) { return true; }
            let i = i + 1;
        }
        // traffic cars
        let r = 0;
        while (r < 4) {
            let m = rowmask[r];
            if (~(m = 0)) {
                let y = rowy[r];
                if (~((y > 1800) | (y < (-1800)))) {
                    let ln = 0;
                    while (ln < 3) {
                        if (~((m & bit[ln]) = 0)) {
                            let ox = lane[ln] - carx;
                            if (~((ox > 1400) | (ox < (-1400)))) {
                                // (a) one of our corners inside their rectangle
                                let i = 0;
                                while (i < 4) {
                                    let ex = cornerX[i] - ox;
                                    let ey = cornerY[i] - y;
                                    if (~((ex < (-400)) | (ex > 400))) {
                                        if (~((ey < (-800)) | (ey > 800))) { return true; }
                                    }
                                    let i = i + 1;
                                }
                                // (b) one of their corners inside our rectangle
                                let k = 0;
                                while (k < 4) {
                                    if ((k & 1) = 0) { let ex = ox - 400; } else { let ex = ox + 400; }
                                    if ((k & 2) = 0) { let ey = y - 800; } else { let ey = y + 800; }
                                    if (~((ex > 1024) | (ex < (-1024)) | (ey > 1024) | (ey < (-1024)))) {
                                        let ex = ex / 16;
                                        let ey = ey / 16;
                                        let u = (ex * cs) - (ey * sn);       // across the car, x128
                                        let v = (-(ex * sn)) - (ey * cs);    // along the car,  x128
                                        if (~((u < (-3200)) | (u > 3200))) {
                                            if (~((v < (-6400)) | (v > 6400))) { return true; }
                                        }
                                    }
                                    let k = k + 1;
                                }
                            }
                        }
                        let ln = ln + 1;
                    }
                }
            }
            let r = r + 1;
        }
        return false;
    }

    function int getCarX() { return carx; }
    function int getTheta() { return theta; }
    function int getSpeed() { return speed; }
    function int getFwd() { return fwd; }
    function int getPassed() { return passed; }
    function boolean isDead() { return dead; }
    function Array getRowY() { return rowy; }
    function Array getRowMask() { return rowmask; }
    function Array getCornerX() { return cornerX; }
    function Array getCornerY() { return cornerY; }
}
